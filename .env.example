# Fchat 构建/更新配置模板。
# 复制为 .env 并填入实际值（.env 已被 .gitignore 忽略，不会提交）。
# 所有项都可留空：留空则对应功能降级（更新停用 / 打包不自动上传）。

# 自动更新服务地址（静态文件托管，见 core/updater.py；必须是 https）
FCHAT_UPDATE_BASE_URL=https://updates.example.com/static/windows/fchat
FCHAT_UPDATE_MANIFEST=manifest.json

# 打包构建（build_release.py）用
FCHAT_GCC=C:/Tools/mingw64/bin/gcc.exe
FCHAT_UPLOAD_DIR=C:/srv/www/fchat
